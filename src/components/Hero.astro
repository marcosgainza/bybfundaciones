---
import { withBase } from '../lib/url';
---

<section id="inicio" class="hero section">
  <div class="hero-photo-bg" aria-hidden="true"></div>
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <h1 class="hero-title">Ingeniería aplicada a la estabilización de fundaciones.</h1>

    <div class="hero-media">
      <div class="hero-frame">
        <video
          class="hero-video"
          controls
          playsinline
          preload="metadata"
          poster={withBase('/assets/video/metodo-inyeccion-controlada.jpg')}
          aria-label="Video: método de inyección controlada para estabilizar fundaciones, paso a paso"
        >
          <source src={withBase('/assets/video/metodo-inyeccion-controlada.mp4')} type="video/mp4" />
        </video>
      </div>
      <div class="hero-chip">
        <div class="hero-chip-k">Método</div>
        <div class="hero-chip-v">Inyección controlada</div>
      </div>
    </div>

    <div class="hero-bottom">
      <div class="hero-copy">
        <p class="hero-lead">
          Desarrollamos soluciones de ingenieria para el mejoramiento de suelos y la
          estabilización de fundaciones mediante técnicas de inyección controlada,
          aplicadas a las condiciones de cada estructura y terreno.
        </p>
        <p class="hero-sub">
          Intervenimos viviendas, edificios e instalaciones con asentamientos, grietas,
          hundimientos u oquedades, priorizando el análisis técnico, la seguridad
          estructural y la mínima afectación de la obra existente.
        </p>
      </div>
      <div class="hero-actions">
        <a href="#contacto" class="btn btn-accent cta-pulse">Solicitar evaluación técnica →</a>
        <a href="#servicios" class="btn btn-ghost">Ver servicios</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, var(--paper) 0%, var(--mist) 100%);
    overflow: hidden;
  }
  .hero-photo-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        180deg,
        rgba(6, 14, 32, 0.74) 0%,
        rgba(7, 16, 35, 0.66) 50%,
        rgba(9, 20, 43, 0.78) 100%
      ),
      url('/assets/images/hero-inyeccion-maquina.jpg');
    background-repeat: no-repeat, no-repeat;
    background-position: center, center 28%;
    background-size: 100% 100%, cover;
    pointer-events: none;
  }
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(13, 43, 91, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(13, 43, 91, 0.045) 1px, transparent 1px);
    background-size: 44px 44px;
    pointer-events: none;
    mask-image: linear-gradient(180deg, #000, transparent 88%);
  }
  /* Titulo a lo ancho, video grande al medio, texto + botones abajo */
  .hero-inner {
    --hero-w: min(100%, 980px, calc((100svh - 330px) * 16 / 9));
    position: relative;
    padding-block: clamp(40px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-media {
    width: max(var(--hero-w), 560px);
    max-width: 100%;
    margin-top: clamp(24px, 3vw, 36px);
  }
  .hero-bottom {
    width: max(var(--hero-w), 560px);
    max-width: 100%;
    margin-top: clamp(32px, 4vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px 40px;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #e0e3e8;
    padding: 7px 14px;
    border-radius: 100px;
    box-shadow: 0 1px 2px rgba(13, 43, 91, 0.04);
  }
  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .badge span:last-child {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .hero-title {
    max-width: 30ch;
    text-align: center;
    text-wrap: balance;
    font-weight: 800;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 4px 24px rgba(4, 10, 24, 0.45);
  }
  .hero-lead {
    max-width: 62ch;
    font-size: clamp(16px, 1.4vw, 18.5px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 2px 14px rgba(4, 10, 24, 0.35);
  }
  .hero-sub {
    margin-top: 12px;
    max-width: 62ch;
    font-size: 15.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 2px 14px rgba(4, 10, 24, 0.35);
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hero-actions .btn-ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }
  .hero-actions .btn-ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }
  .hero-media {
    position: relative;
    min-width: 0;
  }
  .hero-frame {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 24px 60px -24px rgba(13, 43, 91, 0.4);
    border: 1px solid #e0e3e8;
  }
  /* Pelicula oscura sutil sobre el video (no bloquea los clics) */
  .hero-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(6, 14, 32, 0.18);
    pointer-events: none;
  }
  .hero-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--navy);
  }
  /* Arriba a la derecha: abajo a la izquierda tapaba los controles del video */
  .hero-chip {
    position: absolute;
    right: -14px;
    top: -14px;
    background: var(--navy);
    color: #fff;
    padding: 16px 20px;
    border-radius: 8px;
    box-shadow: 0 12px 30px -10px rgba(13, 43, 91, 0.5);
  }
  .hero-chip-k {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9db2d6;
  }
  .hero-chip-v {
    margin-top: 5px;
    font-size: 16px;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .hero-media,
    .hero-bottom {
      width: 100%;
    }
    .hero-bottom {
      grid-template-columns: 1fr;
    }
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
    /* En celu el video es chico: el chip va debajo, no encima */
    .hero-chip {
      position: static;
      display: inline-block;
      margin-top: 12px;
      padding: 10px 14px;
    }
    .hero-chip-v {
      font-size: 14px;
    }
  }
</style>
