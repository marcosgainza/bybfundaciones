---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ficha from '../components/Ficha.astro';
import Pillars from '../components/Pillars.astro';
import Problems from '../components/Problems.astro';
import Services from '../components/Services.astro';
import Methodology from '../components/Methodology.astro';
import WhyUs from '../components/WhyUs.astro';
import Cases from '../components/Cases.astro';
import Faq from '../components/Faq.astro';
import About from '../components/About.astro';
import LogoAnim from '../components/LogoAnim.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import { site } from '../data/site';
---

<Base>
  <Header />
  <main>
    <Hero />
    <Pillars />
    <div class="fichero">
    <Ficha id="problemas" label="El problema" title="¿Tu propiedad presenta alguno de estos problemas?">
      <Problems />
    </Ficha>
    <Ficha
      id="servicios"
      label="Nuestros servicios"
      title="Soluciones de ingeniería para estabilizar fundaciones y mejorar el suelo."
    >
      <Services />
    </Ficha>
    <Ficha id="metodologia" label="Cómo trabajamos" title="Nuestra metodología de trabajo">
      <Methodology />
    </Ficha>
    <Ficha id="porque" label="Por qué elegirnos" title={`¿Por qué elegir ${site.name}?`}>
      <WhyUs />
    </Ficha>
    <Ficha id="casos" label="Obras realizadas" title="Problemas resueltos, no solo fotos.">
      <Cases />
    </Ficha>
    <Ficha id="faq" label="Preguntas frecuentes" title="Las dudas más comunes, respondidas.">
      <Faq />
    </Ficha>
    <Ficha
      id="nosotros"
      label="Quiénes somos"
      title="Ingeniería, experiencia y compromiso en cada intervención."
    >
      <About />
    </Ficha>
    <Ficha id="marca" label="La marca" title="Cómo nace nuestra empresa">
      <LogoAnim />
    </Ficha>
    </div>
    <Contact />
  </main>
  <Footer />
  <WhatsappFloat />
</Base>
